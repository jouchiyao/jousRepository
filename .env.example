# ===== 复制本文件为 .env 并填写真实值（.env 已被 .gitignore 忽略，不会提交到 GitHub）=====

# 管理员密码（用于解锁不限次数模式 + 访客记录面板）
ADMIN_PASSWORD=852000

# Supabase 项目信息（免费 PostgreSQL，用于访客访问计数）
# 在 Supabase 控制台 → Project Settings → API 中查看
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-or-service-role-key

# 降级存储文件（Supabase 不可用时使用，默认 data/visitors.json）
VISITOR_FALLBACK_FILE=data/visitors.json

# 单次查询最大加载行数（防止 1700 万行直接打爆内存，超出自动截断并提示）
MAX_ROWS=300000

# 数据库连接默认值（可选，填入后可免输入）
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=prictice
DB_USER=coze_read
DB_PASSWORD=
